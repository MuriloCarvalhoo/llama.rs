{
  "enabledPlugins": {
    "ecc@ecc": false,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/lint-hook.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
