#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer XBuf { float x[]; } xb;        // inout
layout(set = 0, binding = 1) readonly buffer FBuf { float f[]; } fb; // freq_table[rope_dim/2]
layout(push_constant) uniform PC {
    uint n_head; uint head_dim; uint rope_dim; float pos;
    // Distancia entre cabecas. Igual a head_dim quando sao contiguas; no Q do qwen35 e
    // 2*head_dim, porque cada cabeca traz query e gate lado a lado.
    uint stride;
} pc;
void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint half_rope = pc.rope_dim / 2u;
    uint total = pc.n_head * half_rope;
    if (idx >= total) return;
    // Batch: a dimensao Y do dispatch e o token do bloco, e `pc.pos` e a posicao do
    // **ultimo** deles — o mesmo significado que ja tinha com n_tok=1, como no
    // `attention.comp`. Cada token gira pelo seu proprio angulo.
    uint t = gl_WorkGroupID.y;
    uint n_tok = gl_NumWorkGroups.y;
    float pos_t = pc.pos - float(n_tok - 1u) + float(t);
    uint h = idx / half_rope;
    uint i = idx % half_rope;
    uint base = t * pc.n_head * pc.stride + h * pc.stride;
    float theta = pos_t * fb.f[i];
    float s = sin(theta);
    float c = cos(theta);
    float a = xb.x[base + 2u * i];
    float b = xb.x[base + 2u * i + 1u];
    xb.x[base + 2u * i]      = a * c - b * s;
    xb.x[base + 2u * i + 1u] = a * s + b * c;
}
