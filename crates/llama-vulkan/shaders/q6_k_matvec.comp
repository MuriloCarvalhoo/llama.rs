#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_integer_dot_product : require

// Matvec Q6_K: y[n_out] = W[n_out x n_in] * x[n_in], com W em superblocos Q6_K.
//
// Superbloco = 256 elementos em 210 bytes:
//   byte   0..127 : ql[128] — 4 bits baixos, dois elementos por byte
//   byte 128..191 : qh[64]  — 2 bits altos, quatro elementos por byte
//   byte 192..207 : scales[16] — i8, um por sub-bloco de 16 elementos
//   byte 208..209 : d (f16)
//
// 210 nao e multiplo de 4, entao o upload alinha cada superbloco em 212 bytes (53 uints)
// para as leituras de 32 bits ficarem alinhadas — mesmo motivo do repack 34 -> 36 do Q8_0.
//
// Paralelizacao: 16 sub-blocos de 16 elementos por superbloco. Cada lane cuida de um
// sub-bloco, entao 4 superblocos por wave de 64 lanes.
//
// O valor de um elemento e `d * scale[sub] * (q - 32)`, com q de 6 bits montado a partir
// de 4 bits de ql e 2 de qh. O agrupamento segue o ggml: dentro de cada metade de 128
// elementos, l percorre 0..31 e produz os elementos l, l+32, l+64, l+96.
//
// Como no Q5_K, a ativacao chega quantizada em int8 e o produto usa o dot empacotado
// (`V_DOT4_I32_I8`). Num uint de ql os 4 nibbles ja estao em bytes separados, entao
// `qlw & 0x0F0F0F0F` monta o operando do dot em uma instrucao.
//
// O -32 sai do laco: soma((q-32)*x) = soma(q*x) - 32*soma(x), com soma(x) vindo de um
// segundo dot contra 0x01010101. Isso evita subtrair byte a byte (que propagaria borrow
// entre bytes). Ver o comentario do Q5_K sobre por que nao vale pre-calcular soma(x).

// 4 waves por workgroup, uma linha de saida cada — mesma razao do Q5_K: com 1 wave por
// workgroup a ocupancia esbarra no limite de workgroups por CU.
layout(local_size_x = 256) in;
const uint ROWS_PER_WG = 4u;

layout(set = 0, binding = 0) readonly buffer WeightBuf { uint w[]; } weight_buf;
// Ativacao quantizada: 8 ints por bloco de 32 (4 i8 empacotados cada).
layout(set = 0, binding = 1) readonly buffer XqBuf { int xq[]; } xq_buf;
// Escala (d_x) por bloco de 32 da ativacao.
layout(set = 0, binding = 2) readonly buffer XdBuf { float xd[]; } xd_buf;
layout(set = 0, binding = 3) writeonly buffer OutBuf { float y[]; } out_buf;

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint row_offset;
} pc;

const uint UINTS_PER_SB = 53u;  // 212 bytes alinhados (210 uteis)

uint sb_byte(uint base_u, uint i) {
    return (weight_buf.w[base_u + (i >> 2u)] >> (8u * (i & 3u))) & 0xFFu;
}

// scales[] sao i8 com sinal.
int sb_scale(uint base_u, uint j) {
    return int(sb_byte(base_u, 192u + j) << 24u) >> 24;
}

void main() {
    uint lane = gl_SubgroupInvocationID;
    uint row = gl_WorkGroupID.x * ROWS_PER_WG + gl_SubgroupID;
    // `row` nao depende de `lane`, entao o return e uniforme no subgroup.
    if (row >= pc.n_out) { return; }

    uint n_sb = pc.n_in / 256u;
    uint row_u = row * n_sb * UINTS_PER_SB;

    uint sub = lane & 15u;        // qual sub-bloco de 16 elementos (0..15)
    uint sb_in_grp = lane >> 4u;  // qual superbloco do grupo de 4

    // Sub-bloco `sub` cobre os elementos [sub*16, sub*16+16). Mapeando para o layout
    // do ggml: metade n = sub/8 (0 ou 1, deslocando ql/qh em 64/32 bytes), e dentro
    // dela o quarto q = (sub%8)/2, que escolhe o nibble de ql e o par de bits de qh.
    // Tudo invariante no laco.
    uint half_i = sub >> 3u;          // 0 ou 1
    uint quarter = (sub >> 1u) & 3u;  // 0..3 -> q1..q4 do laco do ggml
    uint idx16 = (sub & 1u) * 16u;    // metade inferior/superior dos 32 `l`
    uint shift = quarter * 2u;        // 0,2,4,6
    bool hi_nibble = quarter >= 2u;
    // `ql_off`, `qh_off` e `idx16` sao multiplos de 16, entao as somas caem em fronteira
    // de dword e da para ler 4 elementos por load.
    uint ql_u0 = (half_i * 64u + (quarter & 1u) * 32u + idx16) >> 2u;
    uint qh_u0 = (128u + half_i * 32u + idx16) >> 2u;

    float acc = 0.0;
    for (uint sb0 = 0u; sb0 < n_sb; sb0 += 4u) {
        uint sbi = sb0 + sb_in_grp;
        if (sbi >= n_sb) { continue; }

        uint base_u = row_u + sbi * UINTS_PER_SB;
        float d = unpackHalf2x16(weight_buf.w[base_u + 52u]).x; // bytes 208..209
        float ds = d * float(sb_scale(base_u, sub));

        // Dois sub-blocos de 16 compartilham um bloco de 32 da ativacao (a escala d_x e a
        // mesma para os dois); `sub & 1` escolhe qual metade dos 8 ints.
        uint blk = sbi * 8u + (sub >> 1u);
        uint xq0 = blk * 8u + (sub & 1u) * 4u;

        int isum = 0;  // soma q*xq
        int isx = 0;   // soma xq
        for (uint t = 0u; t < 4u; t++) {
            uint qlw = weight_buf.w[base_u + ql_u0 + t];
            uint qhw = weight_buf.w[base_u + qh_u0 + t];
            uint wp = ((hi_nibble ? (qlw >> 4u) : qlw) & 0x0F0F0F0Fu)
                    | (((qhw >> shift) & 0x03030303u) << 4u);
            int xw = xq_buf.xq[xq0 + t];
            isum = dotPacked4x8AccSatEXT(int(wp), xw, isum);
            isx = dotPacked4x8AccSatEXT(0x01010101, xw, isx);
        }
        acc += ds * xd_buf.xd[blk] * float(isum - 32 * isx);
    }

    acc = subgroupAdd(acc);
    if (gl_SubgroupInvocationID == 0u) {
        out_buf.y[row] = acc;
    }
}
