#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_integer_dot_product : require

// Matvec Q5_K: y[n_out] = W[n_out x n_in] * x[n_in], com W em superblocos Q5_K.
//
// Superbloco = 256 elementos em 176 bytes = 44 uints:
//   uint 0      : d (f16 baixo) | dmin (f16 alto)
//   uint 1..3   : scales[12] — 8 pares (escala, minimo) de 6 bits
//   uint 4..11  : qh[32]     — o 5o bit de cada elemento
//   uint 12..43 : qs[128]    — 4 bits baixos, dois elementos por byte
//
// Paralelizacao: o superbloco tem 8 sub-blocos de 32 elementos, cada um com escala e
// minimo proprios — entao 8 lanes cobrem um superbloco e as 64 lanes do wave cobrem 8.
//
// A ativacao chega ja quantizada em int8 por `quantize_x.comp`, em blocos de 32 elementos.
// Isso casa exatamente com o sub-bloco do Q5_K, o que permite usar o mesmo dot empacotado
// (`V_DOT4_I32_I8`) do caminho Q8_0 — 4 MACs por instrucao.
//
// O truque que torna isso barato: num uint de qs os 4 nibbles ja estao em *bytes
// separados*, entao `qsw & 0x0F0F0F0F` produz o operando do dot em UMA instrucao. A versao
// anterior desempacotava byte a byte em f32 e gastava ~38 instrucoes VALU por 4 elementos.
//
// O minimo sai do laco: soma((d*sc*q - dmin*m) * x) = d*sc*soma(q*x) - dmin*m*soma(x),
// e soma(x) vem de um segundo dot contra 0x01010101 sobre o mesmo `xq` ja em registrador.
//
// Ja tentamos pre-calcular soma(x) no `quantize_x.comp` (ela nao depende dos pesos, entao
// e recalculada por todas as n_out linhas): ficou 6% MAIS LENTO. Trocar ~8 instrucoes VALU
// por 2 loads de memoria e mau negocio aqui — depois do dot empacotado este kernel passou
// a ser limitado por memoria, nao por ALU.

// 4 waves por workgroup, uma linha de saida cada. O trabalho por wave e o mesmo de um
// workgroup de 64, mas o numero de workgroups cai 4x: com 1 wave por workgroup a GPU
// esbarra no limite de workgroups residentes por CU antes de encher os slots de wave, e
// a latencia dos loads deixa de ser escondida (medimos ~420 GB/s de 717 GB/s de pico).
layout(local_size_x = 256) in;
const uint ROWS_PER_WG = 4u;

layout(set = 0, binding = 0) readonly buffer WeightBuf { uint w[]; } weight_buf;
// Ativacao quantizada: 8 ints por bloco de 32 (4 i8 empacotados cada).
layout(set = 0, binding = 1) readonly buffer XqBuf { int xq[]; } xq_buf;
// Escala (d_x) por bloco de 32 da ativacao.
layout(set = 0, binding = 2) readonly buffer XdBuf { float xd[]; } xd_buf;
layout(set = 0, binding = 3) writeonly buffer OutBuf { float y[]; } out_buf;

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint row_offset; // vestigial (saida indexada por row absoluta)
} pc;

const uint UINTS_PER_SB = 44u;   // 176 bytes

// Byte `i` do superbloco. Usado so pelas escalas (3 leituras por superbloco).
uint sb_byte(uint base_u, uint i) {
    return (weight_buf.w[base_u + (i >> 2u)] >> (8u * (i & 3u))) & 0xFFu;
}

// Escala e minimo de 6 bits do sub-bloco `j` (0..7), do mesmo esquema do Q4_K.
void scale_min(uint base_u, uint j, out uint sc, out uint m) {
    // scales[] ocupa os bytes 4..15 do superbloco.
    if (j < 4u) {
        sc = sb_byte(base_u, 4u + j) & 63u;
        m  = sb_byte(base_u, 4u + j + 4u) & 63u;
    } else {
        uint a = sb_byte(base_u, 4u + j + 4u);
        uint b = sb_byte(base_u, 4u + j - 4u);
        uint c = sb_byte(base_u, 4u + j);
        sc = (a & 0xFu) | ((b >> 6u) << 4u);
        m  = (a >> 4u)  | ((c >> 6u) << 4u);
    }
}

void main() {
    uint lane = gl_SubgroupInvocationID;
    uint row = gl_WorkGroupID.x * ROWS_PER_WG + gl_SubgroupID;
    // `row` nao depende de `lane`, entao o return e uniforme no subgroup.
    if (row >= pc.n_out) { return; }

    uint n_sb = pc.n_in / 256u;              // superblocos por linha
    uint row_u = row * n_sb * UINTS_PER_SB;  // inicio da linha, em uints

    uint j = lane & 7u;           // qual sub-bloco de 32
    uint sb_in_grp = lane >> 3u;  // qual superbloco do grupo de 8

    // Nos bytes de qs os sub-blocos pares usam o nibble baixo e os impares o alto do mesmo
    // byte, dentro de grupos de 64 elementos. Invariante no laco.
    uint qs_u0 = 12u + (j >> 1u) * 8u;   // qs[] comeca no byte 48 = uint 12
    bool hi_nibble = (j & 1u) != 0u;

    float acc = 0.0;
    for (uint sb0 = 0u; sb0 < n_sb; sb0 += 8u) {
        uint sb = sb0 + sb_in_grp;
        if (sb >= n_sb) { continue; }

        uint base_u = row_u + sb * UINTS_PER_SB;
        vec2 dm = unpackHalf2x16(weight_buf.w[base_u]);   // .x = d, .y = dmin
        uint sc, m;
        scale_min(base_u, j, sc, m);

        uint blk = sb * 8u + j;   // bloco de 32 da ativacao == este sub-bloco
        uint xq0 = blk * 8u;

        int isum = 0;  // soma q*xq
        int isx = 0;   // soma xq
        for (uint t = 0u; t < 8u; t++) {
            uint qsw = weight_buf.w[base_u + qs_u0 + t];  // 4 elementos (1 nibble cada)
            uint qhw = weight_buf.w[base_u + 4u + t];     // os 5os bits dos mesmos 4
            uint wp = ((hi_nibble ? (qsw >> 4u) : qsw) & 0x0F0F0F0Fu)
                    | (((qhw >> j) & 0x01010101u) << 4u);
            int xw = xq_buf.xq[xq0 + t];
            isum = dotPacked4x8AccSatEXT(int(wp), xw, isum);
            isx = dotPacked4x8AccSatEXT(0x01010101, xw, isx);
        }
        acc += xd_buf.xd[blk] * (dm.x * float(sc) * float(isum) - dm.y * float(m) * float(isx));
    }

    acc = subgroupAdd(acc);
    if (gl_SubgroupInvocationID == 0u) {
        out_buf.y[row] = acc;
    }
}
