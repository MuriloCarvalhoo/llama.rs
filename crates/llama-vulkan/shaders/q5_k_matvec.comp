#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_integer_dot_product : require

// Matvec Q5_K: y[n_out] = W[n_out x n_in] * x[n_in], com W em superblocos Q5_K.
//
// Superbloco = 256 elementos em 176 bytes = 44 uints = **11 uvec4**:
//   uvec4 0     : .x = d|dmin (f16 par), .yzw = scales[12] — 8 pares (escala, minimo) de 6 bits
//   uvec4 1..2  : qh[32]  — o 5o bit de cada elemento
//   uvec4 3..10 : qs[128] — 4 bits baixos, dois elementos por byte
//
// Todo o superbloco cai em fronteira de 16 bytes (176 = 11*16), e as linhas tambem
// (n_sb*176), entao o buffer inteiro e indexavel como uvec4 sem nenhum repack.
//
// Paralelizacao: o superbloco tem 8 sub-blocos de 32 elementos, cada um com escala e
// minimo proprios — entao 8 lanes cobrem um superbloco e as 64 lanes do wave cobrem 8.
//
// Leitura em uvec4 (em vez de escalar) e duas linhas de saida por wave sao o que fecham a
// maior parte da banda — o kernel e limitado pela taxa de requests ao L1, nao pelos bytes
// em si. Alternativas medidas e descartadas em `docs/performance-tuning.md`.
//
// A ativacao chega ja quantizada em int8 por `quantize_x.comp`, em blocos de 32 elementos.
// Isso casa exatamente com o sub-bloco do Q5_K, o que permite usar o mesmo dot empacotado
// (`V_DOT4_I32_I8`) do caminho Q8_0 — 4 MACs por instrucao.
//
// O truque que torna isso barato: num uint de qs os 4 nibbles ja estao em *bytes
// separados*, entao `qsw & 0x0F0F0F0F` produz o operando do dot em UMA instrucao.
//
// O minimo sai do laco: soma((d*sc*q - dmin*m) * x) = d*sc*soma(q*x) - dmin*m*soma(x),
// e soma(x) vem de um segundo dot contra 0x01010101 sobre o mesmo `xq` ja em registrador.

// Geometria do dispatch, por specialization constant — os dois valores mudam a pressao de
// registrador e com ela a ocupancia, e o melhor par depende do modelo. Ver `MATVEC_GEOM`
// no Rust, `scripts/tune-matvec.sh` para a varredura, e `docs/performance-tuning.md` para
// os numeros medidos e por que mais ocupancia nao ajuda aqui.
//
//   WG_SIZE        lanes por workgroup (multiplo de 64; 256 = 4 waves)
//   ROWS_PER_WAVE  linhas de saida que cada wave acumula
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WG_SIZE = 256u;
layout(constant_id = 1) const uint ROWS_PER_WAVE = 2u;
const uint WAVES_PER_WG = WG_SIZE / 64u;
const uint MAX_ROWS = 4u;   // teto do array de acumuladores

layout(set = 0, binding = 0) readonly buffer WeightBuf { uvec4 w4[]; } weight_buf;
// Ativacao quantizada: 8 ints por bloco de 32 (4 i8 empacotados cada) = 2 ivec4.
layout(set = 0, binding = 1) readonly buffer XqBuf { ivec4 xq4[]; } xq_buf;
// Escala (d_x) por bloco de 32 da ativacao.
layout(set = 0, binding = 2) readonly buffer XdBuf { float xd[]; } xd_buf;
layout(set = 0, binding = 3) writeonly buffer OutBuf { float y[]; } out_buf;
// O bias da projecao entra aqui em vez de num dispatch `add` proprio: eram 3 adds por
// camada (q, k, v) movendo 20 KB cada em ~4.8 us, ou seja latencia de lancamento pura.
// Somar no fim do matvec custa uma leitura de 4 bytes por linha de saida. E o que o
// llama.cpp faz ao fundir mul_mat com o bias.
layout(set = 0, binding = 4) readonly buffer BiasBuf { float b[]; } bias_buf;


layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint row_offset; // vestigial (saida indexada por row absoluta)
    uint tem_bias;   // 0 quando o binding 4 nao tem bias de verdade ligado
} pc;

const uint UVEC4_PER_SB = 11u;   // 176 bytes

// Byte `i` (0..11) de scales[], que ocupa os bytes 4..15 do superbloco — os componentes
// .yzw do primeiro uvec4, aqui ja em registrador.
uint scale_byte(uvec4 hdr, uint i) {
    uint word = i < 4u ? hdr.y : (i < 8u ? hdr.z : hdr.w);
    return (word >> (8u * (i & 3u))) & 0xFFu;
}

// Escala e minimo de 6 bits do sub-bloco `j` (0..7), do mesmo esquema do Q4_K.
void scale_min(uvec4 hdr, uint j, out uint sc, out uint m) {
    if (j < 4u) {
        sc = scale_byte(hdr, j) & 63u;
        m  = scale_byte(hdr, j + 4u) & 63u;
    } else {
        uint a = scale_byte(hdr, j + 4u);
        uint b = scale_byte(hdr, j - 4u);
        uint c = scale_byte(hdr, j);
        sc = (a & 0xFu) | ((b >> 6u) << 4u);
        m  = (a >> 4u)  | ((c >> 6u) << 4u);
    }
}

// Monta os 4 pesos de 5 bits empacotados em bytes, prontos para o dot: nibble de `qsw`
// (baixo ou alto) mais o 5o bit vindo do bit `j` de cada byte de `qhw`.
uint wpack(uint qsw, uint qhw, bool hi, uint j) {
    return ((hi ? (qsw >> 4u) : qsw) & 0x0F0F0F0Fu) | (((qhw >> j) & 0x01010101u) << 4u);
}

// Contribuicao de um superbloco de uma linha para o acumulador: le os 5 uvec4 do peso e
// faz os 8 dots contra a ativacao ja em registrador.
float linha(uint base4, uint j, uint qs_v0, bool hi_nibble, ivec4 xa, ivec4 xb, int isx,
            float xd) {
    uvec4 hdr = weight_buf.w4[base4];
    vec2 dm = unpackHalf2x16(hdr.x);   // .x = d, .y = dmin
    uint sc, m;
    scale_min(hdr, j, sc, m);

    uvec4 qh0 = weight_buf.w4[base4 + 1u];
    uvec4 qh1 = weight_buf.w4[base4 + 2u];
    uvec4 qs0 = weight_buf.w4[base4 + qs_v0];
    uvec4 qs1 = weight_buf.w4[base4 + qs_v0 + 1u];

    // Componentes constantes: indexar uvec4 por variavel forcaria spill para scratch.
    int isum = 0;  // soma q*xq
    isum = dotPacked4x8AccSatEXT(int(wpack(qs0.x, qh0.x, hi_nibble, j)), xa.x, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs0.y, qh0.y, hi_nibble, j)), xa.y, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs0.z, qh0.z, hi_nibble, j)), xa.z, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs0.w, qh0.w, hi_nibble, j)), xa.w, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs1.x, qh1.x, hi_nibble, j)), xb.x, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs1.y, qh1.y, hi_nibble, j)), xb.y, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs1.z, qh1.z, hi_nibble, j)), xb.z, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs1.w, qh1.w, hi_nibble, j)), xb.w, isum);

    return xd * (dm.x * float(sc) * float(isum) - dm.y * float(m) * float(isx));
}

void main() {
    uint lane = gl_SubgroupInvocationID;
    uint row = (gl_WorkGroupID.x * WAVES_PER_WG + gl_SubgroupID) * ROWS_PER_WAVE;
    // `row` nao depende de `lane`, entao o return e uniforme no subgroup.
    if (row >= pc.n_out) { return; }

    uint n_sb = pc.n_in / 256u;                    // superblocos por linha
    uint linha4 = n_sb * UVEC4_PER_SB;             // uvec4 por linha
    uint row4 = row * linha4;                      // inicio da linha, em uvec4

    uint j = lane & 7u;           // qual sub-bloco de 32
    uint sb_in_grp = lane >> 3u;  // qual superbloco do grupo de 8

    // Nos bytes de qs os sub-blocos pares usam o nibble baixo e os impares o alto do mesmo
    // byte, dentro de grupos de 64 elementos. Invariante no laco.
    uint qs_v0 = 3u + (j >> 1u) * 2u;   // qs[] comeca no uvec4 3
    bool hi_nibble = (j & 1u) != 0u;

    // `ROWS_PER_WAVE` e constante de compilacao, entao os dois lacos sobre `r` sao
    // desenrolados e `acc[]` fica em registrador — indexacao dinamica aqui iria para
    // scratch e custaria mais do que todo o resto do kernel.
    float acc[MAX_ROWS];
    for (uint r = 0u; r < MAX_ROWS; r++) { acc[r] = 0.0; }

    for (uint sb0 = 0u; sb0 < n_sb; sb0 += 8u) {
        uint sb = sb0 + sb_in_grp;
        if (sb >= n_sb) { continue; }

        uint base4 = row4 + sb * UVEC4_PER_SB;

        uint blk = sb * 8u + j;   // bloco de 32 da ativacao == este sub-bloco
        ivec4 xa = xq_buf.xq4[blk * 2u];
        ivec4 xb = xq_buf.xq4[blk * 2u + 1u];
        float xd = xd_buf.xd[blk];

        // soma xq: so depende da ativacao, entao vale para as duas linhas.
        int isx = 0;
        isx = dotPacked4x8AccSatEXT(0x01010101, xa.x, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xa.y, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xa.z, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xa.w, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xb.x, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xb.y, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xb.z, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xb.w, isx);

        for (uint r = 0u; r < ROWS_PER_WAVE; r++) {
            // Uniforme no subgroup (`row` nao depende de lane): sem divergencia.
            if (row + r < pc.n_out) {
                acc[r] += linha(base4 + r * linha4, j, qs_v0, hi_nibble, xa, xb, isx, xd);
            }
        }
    }

    for (uint r = 0u; r < ROWS_PER_WAVE; r++) {
        float s = subgroupAdd(acc[r]);
        if (lane == 0u && row + r < pc.n_out) {
            out_buf.y[row + r] = pc.tem_bias != 0u ? s + bias_buf.b[row + r] : s;
        }
    }
}
