#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_control_flow_attributes : require

// A recorrencia do gated delta net (arquiteturas hibridas tipo qwen35) sobre um bloco de
// `n_tok` tokens.
//
// Substitui a atencao em 3 de cada 4 camadas do Qwen3.8: em vez de um KV-cache que
// cresce, cada cabeca carrega um estado `d x d` de tamanho fixo, que este shader le,
// atualiza e reescreve.
//
// Por cabeca h, coluna `col` do estado (guardado transposto, `M[col][i] = S[i][col]`) e
// token `t` do bloco:
//
//   kv     = sum_i M[col][i] * k[t][i]
//   delta  = (v[t][col] - exp(g[t]) * kv) * beta[t]
//   M[col] = exp(g[t]) * M[col] + k[t] * delta   // decaimento e posto 1, fundidos
//   out[t] = sum_i M[col][i] * q[t][i] / sqrt(d)
//
// **Uma wave por coluna, com o estado em registrador.** Cada lane guarda `d / 64`
// elementos da coluna, entao as 64 lanes cobrem a coluna inteira e os dois produtos
// internos viram `subgroupAdd`. Lanes vizinhas leem posicoes vizinhas da coluna — acesso
// coalescido.
//
// **O laco sobre os tokens do bloco mora aqui dentro**, e e o que torna o prefill em batch
// viavel: a recorrencia e serial por construcao (o token t depende do estado depois de
// t-1), mas isso nao obriga um dispatch por token. Com o laco no kernel o estado toca a
// memoria global **uma vez na entrada e uma na saida do dispatch**, nao a cada token — no
// desenho anterior um bloco de N tokens relia e regravava N vezes os 3,1 MB de estado por
// camada, com uma barreira de pipeline entre cada par. `n_tok = 1` reproduz exatamente o
// decode. O desenho segue `gated_delta_net.comp` do backend Vulkan do llama.cpp.
//
// Os lacos sobre `por_lane` sao limitados por `MAX_POR_LANE` (compile-time) com guarda de
// runtime: o indice de `s_reg`/`k_reg`/`q_reg` precisa ser constante depois do unroll para
// os arrays ficarem em VGPR. Com o limite de runtime direto eles iriam para scratch — e
// scratch e memoria global, que e justamente o que este desenho existe para evitar.

layout(local_size_x = 64, local_size_y = 4) in;  // 4 colunas por workgroup, uma wave cada

layout(set = 0, binding = 0) buffer StateBuf { float s[]; } state_buf;   // inout [n_heads][d][d]
layout(set = 0, binding = 1) readonly buffer QBuf { float q[]; } q_buf;  // [n_tok][n_k_heads][d]
layout(set = 0, binding = 2) readonly buffer KBuf { float k[]; } k_buf;  // [n_tok][n_k_heads][d]
layout(set = 0, binding = 3) readonly buffer VBuf { float v[]; } v_buf;  // [n_tok][n_heads][d], passo `v_stride`
// (g, beta) por cabeca, empacotados num vec2: os dois sao lidos juntos e uma vez so.
layout(set = 0, binding = 4) readonly buffer GBuf { vec2 gb[]; } g_buf;  // [n_tok][n_heads]
layout(set = 0, binding = 5) writeonly buffer OutBuf { float o[]; } out_buf; // [n_tok][n_heads][d]

layout(push_constant) uniform PC {
    uint d;        // dimensao da cabeca (= d_state); multiplo de 64
    uint n_heads;  // cabecas de valor
    uint rep;      // cabecas de valor por cabeca de chave (GQA): 3 no Qwen3.8
    uint n_tok;    // tokens do bloco processados neste dispatch (1 no decode)
    // Distancia em floats entre tokens no buffer de `v`. Nao e `n_heads * d`: no plano, v
    // e uma fatia do buffer da convolucao, que traz q | k | v por token — entao o passo e
    // `conv_dim`, e so o chamador o conhece.
    uint v_stride;
} pc;

const uint LANES = 64u;
const uint MAX_POR_LANE = 4u;   // cobre d ate 256

void main() {
    // Workgroups linearizados em x: `d / local_size_y` por cabeca. O dispatch do plano
    // so varia a dimensao x, entao a divisao acontece aqui.
    uint wg_por_head = pc.d / gl_WorkGroupSize.y;
    uint h = gl_WorkGroupID.x / wg_por_head;
    uint col = (gl_WorkGroupID.x % wg_por_head) * gl_WorkGroupSize.y + gl_LocalInvocationID.y;
    uint lane = gl_LocalInvocationID.x;
    // `h` e `col` nao dependem de `lane`: o return e uniforme na wave, entao os
    // `subgroupAdd` do laco abaixo nunca ficam em fluxo divergente.
    if (h >= pc.n_heads || col >= pc.d) { return; }

    uint por_lane = pc.d / LANES;
    // q e k tem menos cabecas que v (GQA): o llama.cpp expande de num_k_heads para
    // num_v_heads com `ggml_repeat`, cuja semantica e MODULO (`dest[i] = src[i %
    // ne_src]`), nao blocos — confirmado em ggml_compute_forward_repeat_f32
    // (ggml/src/ggml-cpu/ops.cpp): o indice de destino e `i1*ne01 + k1` e ele copia de
    // `k1 = i1*ne01+k1) % ne01`. Cabeca de valor `h` le a cabeca de chave `h % n_k_heads`
    // (entrelacado: h=0,1,2,3,4,5 -> chave 0,1,0,1,0,1 quando n_k_heads=2), NAO `h / rep`
    // (blocos: 0,0,0,1,1,1). Indexar aqui evita materializar a repeticao num buffer.
    uint n_k_heads = pc.n_heads / pc.rep;
    uint qk_stride = n_k_heads * pc.d;   // passo entre tokens em q e k
    uint out_stride = pc.n_heads * pc.d; // idem em out
    uint base_qk = (h % n_k_heads) * pc.d;
    uint base_h = h * pc.d;
    uint base_col = h * pc.d * pc.d + col * pc.d;

    // O estado entra em registrador uma vez e so volta a memoria depois do ultimo token.
    float s_reg[MAX_POR_LANE];
    [[unroll]] for (uint r = 0u; r < MAX_POR_LANE; r++) {
        if (r < por_lane) { s_reg[r] = state_buf.s[base_col + r * LANES + lane]; }
    }

    for (uint t = 0u; t < pc.n_tok; t++) {
        vec2 gb = g_buf.gb[t * pc.n_heads + h];
        float decay = exp(gb.x);
        float beta = gb.y;

        float k_reg[MAX_POR_LANE];
        float q_reg[MAX_POR_LANE];
        float kv = 0.0;
        [[unroll]] for (uint r = 0u; r < MAX_POR_LANE; r++) {
            if (r < por_lane) {
                uint i = t * qk_stride + base_qk + r * LANES + lane;
                k_reg[r] = k_buf.k[i];
                q_reg[r] = q_buf.q[i];
                kv += s_reg[r] * k_reg[r];
            }
        }
        kv = subgroupAdd(kv);

        // `kv` sai uniforme na wave; o decaimento entra aqui em vez de numa passada propria
        // sobre o estado, porque `dot(decay * M[col], k) == decay * dot(M[col], k)`.
        float delta = (v_buf.v[t * pc.v_stride + base_h + col] - decay * kv) * beta;

        float acc = 0.0;
        [[unroll]] for (uint r = 0u; r < MAX_POR_LANE; r++) {
            if (r < por_lane) {
                s_reg[r] = decay * s_reg[r] + k_reg[r] * delta;
                acc += s_reg[r] * q_reg[r];
            }
        }
        acc = subgroupAdd(acc);

        if (lane == 0u) {
            out_buf.o[t * out_stride + base_h + col] = acc * inversesqrt(float(pc.d));
        }
    }

    [[unroll]] for (uint r = 0u; r < MAX_POR_LANE; r++) {
        if (r < por_lane) { state_buf.s[base_col + r * LANES + lane] = s_reg[r]; }
    }
}
