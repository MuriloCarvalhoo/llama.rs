#version 450

// Um passo da recorrência do gated delta net (arquiteturas híbridas tipo qwen35).
//
// Substitui a atenção em 3 de cada 4 camadas do Qwen3.8: em vez de um KV-cache que
// cresce, cada cabeça carrega um estado `d × d` de tamanho fixo, que este shader lê,
// atualiza e reescreve a cada token.
//
// Por cabeça h e linha j do estado (guardado transposto, `M[j][i] = S[i][j]`):
//
//   M[j]   *= exp(g[h])                        // decaimento
//   delta_j = (v[h][j] - dot(M[j], k[h])) * beta[h]
//   M[j]   += delta_j * k[h]                   // atualizacao de posto 1
//   out[j]  = dot(M[j], q[h]) / sqrt(d)
//
// **As linhas nao se falam.** Cada uma le e escreve so a sua fatia de `d` floats do
// estado, e os dois produtos internos sao locais — nao ha reducao entre lanes, o que
// torna este kernel trivialmente paralelo em `n_heads * d` threads.
//
// q e k sao os mesmos para todas as `d` linhas de uma cabeca, entao vao para LDS: sao
// 2*d floats lidos uma vez por workgroup em vez de d vezes.

layout(local_size_x = 128) in;  // uma thread por linha do estado; d = 128 no Qwen3.8

layout(set = 0, binding = 0) buffer StateBuf { float s[]; } state_buf;   // inout [n_heads][d][d]
layout(set = 0, binding = 1) readonly buffer QBuf { float q[]; } q_buf;  // [n_heads][d]
layout(set = 0, binding = 2) readonly buffer KBuf { float k[]; } k_buf;  // [n_heads][d]
layout(set = 0, binding = 3) readonly buffer VBuf { float v[]; } v_buf;  // [n_heads][d]
// (g, beta) por cabeca, empacotados num vec2: os dois sao lidos juntos e uma vez so.
layout(set = 0, binding = 4) readonly buffer GBuf { vec2 gb[]; } g_buf;  // [n_heads]
layout(set = 0, binding = 5) writeonly buffer OutBuf { float o[]; } out_buf; // [n_heads][d]

layout(push_constant) uniform PC {
    uint d;        // dimensao da cabeca (= d_state)
    uint n_heads;  // cabecas de valor
    uint pad;
} pc;

shared float s_q[256];
shared float s_k[256];

void main() {
    uint h = gl_WorkGroupID.x;
    uint j = gl_LocalInvocationID.x;
    if (h >= pc.n_heads) { return; }

    uint base_h = h * pc.d;
    // Carrega q e k da cabeca em LDS (uma passada por thread cobre d <= local_size).
    if (j < pc.d) {
        s_q[j] = q_buf.q[base_h + j];
        s_k[j] = k_buf.k[base_h + j];
    }
    barrier();

    if (j >= pc.d) { return; }

    vec2 gb = g_buf.gb[h];
    float decay = exp(gb.x);
    float beta = gb.y;

    uint linha = h * pc.d * pc.d + j * pc.d;

    // Passada 1: decaimento e produto interno com k, na mesma leitura do estado.
    float pred = 0.0;
    for (uint i = 0u; i < pc.d; i++) {
        float m = state_buf.s[linha + i] * decay;
        state_buf.s[linha + i] = m;
        pred += m * s_k[i];
    }

    float delta = (v_buf.v[base_h + j] - pred) * beta;

    // Passada 2: atualizacao de posto 1 e leitura com q.
    float acc = 0.0;
    for (uint i = 0u; i < pc.d; i++) {
        float m = state_buf.s[linha + i] + delta * s_k[i];
        state_buf.s[linha + i] = m;
        acc += m * s_q[i];
    }

    out_buf.o[base_h + j] = acc * inversesqrt(float(pc.d));
}
