#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_integer_dot_product : require

// Matvec Q4_K: y[n_out] = W[n_out x n_in] * x[n_in], com W em superblocos Q4_K crus.
//
// Superbloco = 256 elementos em 144 bytes = 36 uints = **9 uvec4**:
//   uvec4 0    : .x = d|dmin (f16 par), .yzw = scales[12] — 8 pares (escala, minimo) de 6 bits
//   uvec4 1..8 : qs[128] — 4 bits por elemento, dois elementos por byte
//
// Igual ao Q5_K (`q5_k_matvec.comp`), sem o 5o bit por elemento — Q4_K não tem `qh`. Essa é
// a única diferença: `wpack` aqui não recebe `qhw`, e `qs` começa logo depois do cabeçalho
// (uvec4 1) em vez de depois de `qh` (uvec4 3). O resto — geometria, dot empacotado em
// int8, minimo fatorado para fora do laço — é o mesmo kernel, comentado em
// `q5_k_matvec.comp`.

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WG_SIZE = 256u;
layout(constant_id = 1) const uint ROWS_PER_WAVE = 2u;
const uint WAVES_PER_WG = WG_SIZE / 64u;

layout(set = 0, binding = 0) readonly buffer WeightBuf { uvec4 w4[]; } weight_buf;
layout(set = 0, binding = 1) readonly buffer XqBuf { ivec4 xq4[]; } xq_buf;
layout(set = 0, binding = 2) readonly buffer XdBuf { float xd[]; } xd_buf;
layout(set = 0, binding = 3) writeonly buffer OutBuf { float y[]; } out_buf;
// Ver o comentário em `q5_k_matvec.comp`: o bias entra fundido no fim do matvec.
layout(set = 0, binding = 4) readonly buffer BiasBuf { float b[]; } bias_buf;

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint row_offset; // vestigial (saida indexada por row absoluta)
    uint tem_bias;   // 0 quando o binding 4 nao tem bias de verdade ligado
} pc;

const uint UVEC4_PER_SB = 9u;   // 144 bytes
const uint MAX_ROWS = 4u;       // teto do array de acumuladores

// Byte `i` (0..11) de scales[], nos bytes 4..15 do superbloco — .yzw do primeiro uvec4.
uint scale_byte(uvec4 hdr, uint i) {
    uint word = i < 4u ? hdr.y : (i < 8u ? hdr.z : hdr.w);
    return (word >> (8u * (i & 3u))) & 0xFFu;
}

// Escala e minimo de 6 bits do sub-bloco `j` (0..7) — mesmo esquema do Q5_K/Q4_K.
void scale_min(uvec4 hdr, uint j, out uint sc, out uint m) {
    if (j < 4u) {
        sc = scale_byte(hdr, j) & 63u;
        m  = scale_byte(hdr, j + 4u) & 63u;
    } else {
        uint a = scale_byte(hdr, j + 4u);
        uint b = scale_byte(hdr, j - 4u);
        uint c = scale_byte(hdr, j);
        sc = (a & 0xFu) | ((b >> 6u) << 4u);
        m  = (a >> 4u)  | ((c >> 6u) << 4u);
    }
}

// Os 4 pesos de 4 bits empacotados em bytes, prontos para o dot: nibble baixo ou alto de
// `qsw`. Sem 5o bit (essa é a diferença para o `wpack` do Q5_K).
uint wpack(uint qsw, bool hi) {
    return (hi ? (qsw >> 4u) : qsw) & 0x0F0F0F0Fu;
}

float linha(uint base4, uint j, uint qs_v0, bool hi_nibble, ivec4 xa, ivec4 xb, int isx,
            float xd) {
    uvec4 hdr = weight_buf.w4[base4];
    vec2 dm = unpackHalf2x16(hdr.x);   // .x = d, .y = dmin
    uint sc, m;
    scale_min(hdr, j, sc, m);

    uvec4 qs0 = weight_buf.w4[base4 + qs_v0];
    uvec4 qs1 = weight_buf.w4[base4 + qs_v0 + 1u];

    int isum = 0;  // soma q*xq
    isum = dotPacked4x8AccSatEXT(int(wpack(qs0.x, hi_nibble)), xa.x, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs0.y, hi_nibble)), xa.y, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs0.z, hi_nibble)), xa.z, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs0.w, hi_nibble)), xa.w, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs1.x, hi_nibble)), xb.x, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs1.y, hi_nibble)), xb.y, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs1.z, hi_nibble)), xb.z, isum);
    isum = dotPacked4x8AccSatEXT(int(wpack(qs1.w, hi_nibble)), xb.w, isum);

    return xd * (dm.x * float(sc) * float(isum) - dm.y * float(m) * float(isx));
}

void main() {
    uint lane = gl_SubgroupInvocationID;
    uint row = (gl_WorkGroupID.x * WAVES_PER_WG + gl_SubgroupID) * ROWS_PER_WAVE;
    if (row >= pc.n_out) { return; }

    uint n_sb = pc.n_in / 256u;
    uint linha4 = n_sb * UVEC4_PER_SB;
    uint row4 = row * linha4;

    uint j = lane & 7u;
    uint sb_in_grp = lane >> 3u;

    // qs começa no uvec4 1 (logo após o cabeçalho — sem os 2 uvec4 de qh do Q5_K).
    uint qs_v0 = 1u + (j >> 1u) * 2u;
    bool hi_nibble = (j & 1u) != 0u;

    float acc[MAX_ROWS];
    for (uint r = 0u; r < MAX_ROWS; r++) { acc[r] = 0.0; }

    for (uint sb0 = 0u; sb0 < n_sb; sb0 += 8u) {
        uint sb = sb0 + sb_in_grp;
        if (sb >= n_sb) { continue; }

        uint base4 = row4 + sb * UVEC4_PER_SB;

        uint blk = sb * 8u + j;
        ivec4 xa = xq_buf.xq4[blk * 2u];
        ivec4 xb = xq_buf.xq4[blk * 2u + 1u];
        float xd = xd_buf.xd[blk];

        int isx = 0;
        isx = dotPacked4x8AccSatEXT(0x01010101, xa.x, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xa.y, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xa.z, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xa.w, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xb.x, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xb.y, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xb.z, isx);
        isx = dotPacked4x8AccSatEXT(0x01010101, xb.w, isx);

        for (uint r = 0u; r < ROWS_PER_WAVE; r++) {
            if (row + r < pc.n_out) {
                acc[r] += linha(base4 + r * linha4, j, qs_v0, hi_nibble, xa, xb, isx, xd);
            }
        }
    }

    for (uint r = 0u; r < ROWS_PER_WAVE; r++) {
        float s = subgroupAdd(acc[r]);
        if (lane == 0u && row + r < pc.n_out) {
            out_buf.y[row + r] = pc.tem_bias != 0u ? s + bias_buf.b[row + r] : s;
        }
    }
}
