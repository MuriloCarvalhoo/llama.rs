#version 450
#extension GL_EXT_integer_dot_product : require

// GEMM Q4_K do prefill: o de `mul_mm.comp` com passo de K = 64 em vez de 32. O par de
// sub-blocos (2p, 2p+1) mora nos mesmos 32 bytes de `qs` — nibble baixo e alto —, então com
// passo 32 cada `uvec4` de `qs` saía da memória duas vezes, e cada 32 elementos pagavam duas
// barreiras. Aqui o par sai uma vez e as barreiras valem para 64 — a direção do MMQ do
// llama.cpp, que carrega K = 256 por vez.
//
// Medido em 2026-09-26 (`bancada_mul_mm`, 256 colunas): ffn_gate 14,0 -> 16,2 TOPS, ffn_down
// 8,7 -> 15,1, attn_qkv 13,1 -> 15,9. Passo 128 (`PARES = 2`) ficou **pior** que 64 em todas
// as formas (ffn_gate 13,1, ffn_down 12,5): o dobro de registradores de carga e de LDS derruba
// a ocupância.
//
// Mesma geometria do `mul_mm.comp`: 256 threads, tile de BM=128 linhas x BN=min(COLS,32)
// colunas, grade 32 x 8 de threads com TM=4 linhas (intercaladas) e TN=BN/8 colunas,
// buffer duplo em registrador para os loads globais do passo seguinte.

layout(local_size_x = 256) in;
layout(constant_id = 0) const uint COLS = 32u;
// Pares de sub-blocos por passo de K: 1 = passo 64. 2 (passo 128) foi medido pior.
const uint PARES = 1u;
const uint SUBS = 2u * PARES;   // sub-blocos de 32 por passo

const uint BM = 128u;
const uint BK = 64u * PARES;
const uint THREADS = 256u;
const uint COL_GRUPOS = 8u;
const uint LINHA_GRUPOS = THREADS / COL_GRUPOS;  // 32
const uint TM = BM / LINHA_GRUPOS;               // 4
const uint BN = COLS < 32u ? COLS : 32u;
const uint TN = BN / COL_GRUPOS;
// 8 uints por sub-bloco + 1: coprimo com os 32 bancos.
const uint LDS_PASSO = 8u * SUBS + 1u;
const uint UVEC4_PER_SB = 9u;   // 144 bytes por superbloco Q4_K

layout(set = 0, binding = 0) readonly buffer WeightBuf { uvec4 w4[]; } weight_buf;
layout(set = 0, binding = 1) readonly buffer XqBuf { int xq[]; } xq_buf;
layout(set = 0, binding = 2) readonly buffer XdBuf { float xd[]; } xd_buf;
layout(set = 0, binding = 3) writeonly buffer OutBuf { float y[]; } out_buf;
layout(set = 0, binding = 4) readonly buffer BiasBuf { float b[]; } bias_buf;

layout(push_constant) uniform PC {
    uint n_in;
    uint n_out;
    uint row_offset;
    uint tem_bias;
} pc;

// Linha r do tile: [sub 0: 8 uints][sub 1: 8 uints][pad]. Cada metade de 16 elementos de um
// sub-bloco vem de uma thread de carga (`w_alta`).
shared uint lw[BM * LDS_PASSO];
shared float lwsc[BM * SUBS];
shared float lwoff[BM * SUBS];
// Coluna c: [bloco 0: 8 ints][bloco 1: 8 ints][pad]; escala e soma de cada um dos dois blocos.
shared int lx[BN * LDS_PASSO];
shared float lxd[BN * SUBS];
shared float lxs[BN * SUBS];

uint scale_byte(uvec4 hdr, uint i) {
    uint word = i < 4u ? hdr.y : (i < 8u ? hdr.z : hdr.w);
    return (word >> (8u * (i & 3u))) & 0xFFu;
}

void scale_min(uvec4 hdr, uint j, out uint sc, out uint m) {
    if (j < 4u) {
        sc = scale_byte(hdr, j) & 63u;
        m  = scale_byte(hdr, j + 4u) & 63u;
    } else {
        uint a = scale_byte(hdr, j + 4u);
        uint b = scale_byte(hdr, j - 4u);
        uint c = scale_byte(hdr, j);
        sc = (a & 0xFu) | ((b >> 6u) << 4u);
        m  = (a >> 4u)  | ((c >> 6u) << 4u);
    }
}

// Loads do passo k0: cabeçalho e o uvec4 de `qs` da metade desta thread (os dois sub-blocos do
// par de uma vez); dois ints de ativação (um de cada bloco de 32) para a coluna `x_col`; e,
// nas 2*BN primeiras threads, escala e os 8 ints de um bloco (coluna t/2, bloco t%2).
void buscar(uint k0, uint lg, uint linha4, uint n_blk, bool w_alta, uint x_col, uint x_u,
            uint t, uint col0, inout uvec4 hdr, inout uvec4 qs[PARES], inout int xq[SUBS],
            inout float xd, inout int xs[8]) {
    uint sb = k0 >> 8u;
    uint p0 = (k0 >> 6u) & 3u;      // primeiro par de sub-blocos do passo no superbloco
    uint blk = k0 >> 5u;            // primeiro bloco de 32 da ativação
    if (lg < pc.n_out) {
        uint b4 = lg * linha4 + sb * UVEC4_PER_SB;
        hdr = weight_buf.w4[b4];
        for (uint q = 0u; q < PARES; q++) {
            qs[q] = weight_buf.w4[b4 + 1u + (p0 + q) * 2u + (w_alta ? 1u : 0u)];
        }
    }
    if (x_col < BN) {
        uint base = (col0 + x_col) * n_blk + blk;
        for (uint s = 0u; s < SUBS; s++) { xq[s] = xq_buf.xq[(base + s) * 8u + x_u]; }
    }
    if (t < SUBS * BN) {
        uint cb = (col0 + t / SUBS) * n_blk + blk + t % SUBS;
        xd = xd_buf.xd[cb];
        for (uint u = 0u; u < 8u; u++) { xs[u] = xq_buf.xq[cb * 8u + u]; }
    }
}

void main() {
    uint t = gl_LocalInvocationID.x;
    uint linha0 = gl_WorkGroupID.x * BM;
    uint col0 = gl_WorkGroupID.y * BN;

    uint n_sb = pc.n_in / 256u;
    uint linha4 = n_sb * UVEC4_PER_SB;
    uint n_blk = pc.n_in / 32u;

    uint w_linha = t >> 1u;
    bool w_alta = (t & 1u) != 0u;
    uint x_col = t >> 3u;
    uint x_u = t & 7u;
    uint ti = t >> 3u;
    uint tj = t & 7u;

    float acc[TM * TN];
    for (uint i = 0u; i < TM * TN; i++) { acc[i] = 0.0; }

    uint lg = linha0 + w_linha;
    uvec4 r_hdr = uvec4(0u);
    uvec4 r_qs[PARES];
    for (uint q = 0u; q < PARES; q++) { r_qs[q] = uvec4(0u); }
    int r_xq[SUBS];
    for (uint s = 0u; s < SUBS; s++) { r_xq[s] = 0; }
    float r_xd = 0.0;
    int r_xs[8];
    for (uint u = 0u; u < 8u; u++) { r_xs[u] = 0; }
    buscar(0u, lg, linha4, n_blk, w_alta, x_col, x_u, t, col0, r_hdr, r_qs, r_xq, r_xd, r_xs);

    for (uint k0 = 0u; k0 < pc.n_in; k0 += BK) {
        uint j0 = (k0 >> 5u) & 7u;   // primeiro sub-bloco do passo no superbloco
        barrier();

        uint dst = w_linha * LDS_PASSO + (w_alta ? 4u : 0u);
        if (lg < pc.n_out) {
            for (uint q = 0u; q < PARES; q++) {
                for (uint u = 0u; u < 4u; u++) {
                    lw[dst + q * 16u + u] = r_qs[q][u] & 0x0F0F0F0Fu;               // sub par
                    lw[dst + q * 16u + 8u + u] = (r_qs[q][u] >> 4u) & 0x0F0F0F0Fu;  // sub ímpar
                }
            }
            if (!w_alta) {
                vec2 dm = unpackHalf2x16(r_hdr.x);
                for (uint s = 0u; s < SUBS; s++) {
                    uint sc, m;
                    scale_min(r_hdr, j0 + s, sc, m);
                    lwsc[w_linha * SUBS + s] = dm.x * float(sc);
                    lwoff[w_linha * SUBS + s] = -dm.y * float(m);
                }
            }
        } else if (!w_alta) {
            for (uint s = 0u; s < SUBS; s++) {
                lwsc[w_linha * SUBS + s] = 0.0;
                lwoff[w_linha * SUBS + s] = 0.0;
            }
        }
        if (x_col < BN) {
            for (uint s = 0u; s < SUBS; s++) { lx[x_col * LDS_PASSO + s * 8u + x_u] = r_xq[s]; }
        }
        if (t < SUBS * BN) {
            lxd[t] = r_xd;
            int isx = 0;
            for (uint u = 0u; u < 8u; u++) {
                isx = dotPacked4x8AccSatEXT(0x01010101, r_xs[u], isx);
            }
            lxs[t] = float(isx);
        }

        barrier();

        if (k0 + BK < pc.n_in) {
            buscar(k0 + BK, lg, linha4, n_blk, w_alta, x_col, x_u, t, col0, r_hdr, r_qs, r_xq,
                   r_xd, r_xs);
        }

        // Um sub-bloco por vez: as colunas dele saem da LDS e servem as TM linhas, e o número
        // de registradores fica o do passo 32.
        for (uint s = 0u; s < SUBS; s++) {
            int xr[TN * 8u];
            float xd_c[TN];
            float xs_c[TN];
            for (uint c = 0u; c < TN; c++) {
                uint col = tj * TN + c;
                for (uint u = 0u; u < 8u; u++) { xr[c * 8u + u] = lx[col * LDS_PASSO + s * 8u + u]; }
                xd_c[c] = lxd[col * SUBS + s];
                xs_c[c] = lxs[col * SUBS + s];
            }
            for (uint r = 0u; r < TM; r++) {
                uint rr = r * LINHA_GRUPOS + ti;
                float sc = lwsc[rr * SUBS + s];
                float off = lwoff[rr * SUBS + s];
                int w[8];
                for (uint u = 0u; u < 8u; u++) { w[u] = int(lw[rr * LDS_PASSO + s * 8u + u]); }
                for (uint c = 0u; c < TN; c++) {
                    int isum = 0;
                    for (uint u = 0u; u < 8u; u++) {
                        isum = dotPacked4x8AccSatEXT(w[u], xr[c * 8u + u], isum);
                    }
                    acc[r * TN + c] += xd_c[c] * (sc * float(isum) + off * xs_c[c]);
                }
            }
        }
    }

    for (uint r = 0u; r < TM; r++) {
        uint rr = linha0 + r * LINHA_GRUPOS + ti;
        if (rr >= pc.n_out) { continue; }
        float bias = pc.tem_bias != 0u ? bias_buf.b[rr] : 0.0;
        for (uint c = 0u; c < TN; c++) {
            out_buf.y[(col0 + tj * TN + c) * pc.n_out + rr] = acc[r * TN + c] + bias;
        }
    }
}
